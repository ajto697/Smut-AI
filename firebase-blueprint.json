{
  "entities": {
    "student": {
      "title": "Student",
      "description": "Student profile and credentials data.",
      "type": "object",
      "properties": {
        "mssv": { "type": "string", "description": "Student ID" },
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "Email address" },
        "password": { "type": "string", "description": "Encoded password or pin" },
        "phone": { "type": "string", "description": "Contact phone" },
        "major": { "type": "string", "description": "Field of study" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "isVerified": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["mssv", "name", "password"]
    },
    "chat": {
      "title": "Chat Message",
      "description": "Secure chat logs for a student.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "content", "timestamp"]
    },
    "notification": {
      "title": "Notification",
      "description": "Student notification record.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["deadline", "event", "system"] },
        "isRead": { "type": "boolean" },
        "timestamp": { "type": "integer" }
      },
      "required": ["studentId", "title", "message", "type", "isRead", "timestamp"]
    },
    "calendarEvent": {
      "title": "Calendar Event",
      "description": "Important academic dates and deadlines.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["exam", "registration", "holiday", "event"] },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] }
      },
      "required": ["title", "date", "type"]
    },
    "kpiEvidence": {
      "title": "KPI Evidence",
      "description": "Student training criteria evidence and approval record.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "kpiId": { "type": "string" },
        "code": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "points": { "type": "integer" },
        "status": { "type": "string", "enum": ["not_submitted", "pending", "approved", "rejected"] },
        "evidenceFile": { "type": "string" },
        "evidenceText": { "type": "string" },
        "evidenceImage": { "type": "string" },
        "comment": { "type": "string" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["studentId", "code", "points", "status"]
    },
    "quizResult": {
      "title": "Quiz Result",
      "description": "Student quiz and practice exam performance record.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "subjectName": { "type": "string" },
        "score": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "percentage": { "type": "integer" },
        "timestamp": { "type": "integer" }
      },
      "required": ["studentId", "subjectName", "score", "totalQuestions", "percentage", "timestamp"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "student",
      "description": "Collection of student profiles."
    },
    "/chats/{chatId}": {
      "schema": "chat",
      "description": "Individual chat messages."
    },
    "/notifications/{notificationId}": {
      "schema": "notification",
      "description": "Student notifications collection."
    },
    "/calendarEvents/{eventId}": {
      "schema": "calendarEvent",
      "description": "Global academic calendar events."
    },
    "/kpiEvidence/{kpiDocId}": {
      "schema": "kpiEvidence",
      "description": "Collection of student training KPI items and submitted proofs."
    },
    "/quizResults/{resultId}": {
      "schema": "quizResult",
      "description": "Historical quiz and exam test results."
    }
  }
}
