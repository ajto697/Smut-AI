rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    // Hardened helpers
    function isValidId(id) {
      return id is string && id.size() <= 32 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }

    // Student identity registry (Zero Trust Access)
    match /students/{studentId} {
      // Allow single document lookup if studentId is known. 
      // This is secure because IDs are MSSVs, and listing is strictly forbidden.
      allow get: if isValidId(studentId);
      
      // FORBIDDEN: Scraping student directory
      allow list: if false;
      
      // Strict data blueprint
      function isValidStudent(data) {
        return data.keys().hasAll(['mssv', 'name', 'password']) &&
               data.mssv is string && data.mssv.size() <= 20 &&
               data.name is string && data.name.size() <= 100 &&
               data.password is string && data.password.size() <= 128;
      }

      // System-level data provisioning (Demo mode)
      allow create, update: if isValidId(studentId) && isValidStudent(incoming());
    }

    // Secure Chat Records
    match /chats/{chatId} {
      function isValidChat(data) {
        return data.role in ['user', 'assistant'] &&
               data.content is string && data.content.size() <= 4000 &&
               data.timestamp is int;
      }
      
      // Only allow creation of new logs
      allow create: if isValidId(chatId) && isValidChat(incoming());
      
      // Prohibit reading back chat logs for absolute session privacy in demo
      allow read, list: if false;
    }

    // Notifications security
    match /notifications/{notificationId} {
      // Allow reading notifications for a specific student
      // This forces the client to use a where('studentId', '==', ...) filter
      allow list: if isValidId(resource.data.studentId);
      allow get: if true;
      
      // Allow marking as read (update isRead field)
      allow update: if incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      
      // System allows creation for demo
      allow create: if isValidId(incoming().studentId);
    }

    // Academic Calendar Events
    match /calendarEvents/{eventId} {
      allow read, list: if true;
      allow create: if isValidId(eventId) && 
                      incoming().type in ['exam', 'registration', 'holiday', 'event'] &&
                      incoming().priority in ['high', 'medium', 'low'];
    }
  }
}
