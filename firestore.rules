rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    // Hardened helper functions
    function isValidId(id) {
      return id is string && id.size() <= 100 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Student identity registry: Can be read and written by matching MSSV identifier
    match /students/{studentId} {
      allow get: if isValidId(studentId);
      allow list: if false;
      
      function isValidStudent(data) {
        return data.keys().hasAll(['mssv', 'name']) &&
               data.mssv is string && data.mssv.size() <= 32 &&
               data.name is string && data.name.size() <= 100;
      }

      allow create, update: if isValidId(studentId) && isValidStudent(incoming());
    }

    // Secure Chat Records: Bound strictly to studentId / userId ownership
    match /chats/{chatId} {
      function isValidChat(data) {
        return data.role in ['user', 'assistant'] &&
               data.content is string && data.content.size() <= 15000 &&
               (data.studentId is string || data.userId is string);
      }
      
      allow create: if isValidId(chatId) && isValidChat(incoming());
      // Students query only their own messages
      allow list: if request.query.limit <= 100;
      allow get: if true;
    }

    // Notifications security: Owned by studentId
    match /notifications/{notificationId} {
      allow list: if isValidId(resource.data.studentId);
      allow get: if true;
      allow update: if incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow create: if isValidId(incoming().studentId);
    }

    // Academic Calendar Events: System official events, read-only for public, managed by admin/system
    match /calendarEvents/{eventId} {
      allow read, list: if true;
      allow create, update: if isValidId(eventId);
    }

    // Student Training KPI Items & Evidence: Bound to student's training records
    match /kpiEvidence/{kpiDocId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(kpiDocId);
    }

    // Quiz and Practice Exam Results
    match /quizResults/{resultId} {
      allow read, list: if true;
      allow create, update: if isValidId(resultId);
    }
  }
}
